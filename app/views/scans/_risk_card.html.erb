<% record = analysis.secret_record %>
<details class="card">
  <summary>
    <%= tier_pill(analysis.risk_tier) %>
    <strong><%= record.name %></strong>
    <span class="muted">
      readiness <%= analysis.readiness_score %>/100
      &middot; <%= record.age_days %>d old<%= " (simulated)" if record.age_simulated? %>
      &middot; <%= record.display_kind %>
      <% if record.vault_name.present? %>&middot; <%= record.vault_name %><% end %>
    </span>
  </summary>

  <h4>Lifecycle</h4>
  <ul>
    <li>Created <%= format_time(record.source_created_at) %></li>
    <li>
      Expires <%= format_time(record.expires_at) %>
      <% if record.expired? %><strong>(past expiry)</strong><% end %>
    </li>
    <li>
      Rotation path:
      <%= record.rotation_enabled? ? "verified" : "none configured" %>
      <% if record.rotation_days.to_i.positive? %>
        (<%= record.rotation_days %> day window)
      <% end %>
    </li>
    <li>
      Authorization: <%= record.rbac_vault? ? "Azure RBAC" : "vault access policy" %>
      <% unless record.rbac_vault? %>
        &middot; <%= pluralize(record.policy_principals.size, "principal") %> granted read
      <% end %>
    </li>
  </ul>

  <h4>Observed consumers (<%= analysis.total_reads %> reads in the lookback window)</h4>
  <% if analysis.consumers.empty? %>
    <p class="muted">
      No reads recorded. Either nothing uses this, or the source is not sending
      audit events to the workspace. Confirm with the owner tag
      (<code><%= record.owner_tag %></code>) before deleting.
    </p>
  <% else %>
    <ul>
      <% analysis.consumers.each do |consumer| %>
        <li>
          <code><%= consumer_label(consumer) %></code>
          <span class="muted">
            <%= consumer["identity_type"] %>
            &middot; <%= consumer["access_count"] %> reads
            &middot; last <%= consumer["last_accessed"] || "unknown" %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h4>Rotation runbook</h4>
  <% if analysis.runbook.blank? %>
    <p class="muted">
      No runbook generated. Runbooks are bounded per scan and go to the worst
      readiness scores first.
    </p>
  <% else %>
    <p>
      Confidence <strong><%= analysis.runbook_confidence %></strong>
      <span class="muted">
        &middot; <%= analysis.runbook["confidence_rationale"] %>
        &middot; generated by <%= analysis.runbook_generator %>
      </span>
    </p>
    <ol>
      <% analysis.runbook["steps"].sort_by { |s| s["order"].to_i }.each do |step| %>
        <li>
          <%= step["action"] %><br>
          <em>Verify: <%= step["verification"] %></em>
        </li>
      <% end %>
    </ol>
    <h4>Rollback</h4>
    <ul>
      <% Array(analysis.runbook["rollback"]).each do |item| %>
        <li><%= item %></li>
      <% end %>
    </ul>
  <% end %>
</details>
